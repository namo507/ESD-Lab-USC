{
  "schema_version": 4,
  "policy": "hosted-provider",
  "provider": "nvidia",
  "runtime": "nvidia-build-api",
  "api_base_env": "DASHBOARD_ASSISTANT_API_BASE",
  "api_key_env": "DASHBOARD_ASSISTANT_API_KEY",
  "model_env": "DASHBOARD_ASSISTANT_MODEL",
  "default_api_base": "https://integrate.api.nvidia.com/v1",
  "default_model": "nvidia/nemotron-3-super-120b-a12b",
  "self_hosted": {
    "enabled_by_default": false,
    "enabled_env": "DASHBOARD_ASSISTANT_SELF_HOSTED_ENABLED",
    "base_url_env": "DASHBOARD_ASSISTANT_SELF_HOSTED_BASE_URL",
    "example_base_url": "http://nemotron-nim:8000/v1"
  },
  "notes": [
    "Runtime values are sourced from environment variables; this file contains no credentials.",
    "The hosted NVIDIA endpoint is the supported default.",
    "Self-hosted NIM requires dedicated GPU infrastructure and is opt-in only."
  ]
}

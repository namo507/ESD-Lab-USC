# ============================================================
# ESD Lab — Environment Configuration Template
#
# `.env` at the repository root is the ONE place credentials live. Every entry
# point (REDCap sync, dashboard server, assistant, operator scripts) loads it
# through src/utils/env_loader.py, so there is a single file and a single
# parsing behaviour.
#
#   cp .env.example .env      # then fill in the values below
#   make env-doctor           # masked report: what is set, missing, or stray
#
# Rules:
#   * `.env` is gitignored and must never be committed.
#   * Values already exported in the environment win over this file, so Compose,
#     Kubernetes, and CI stay authoritative in their own runtimes.
#   * Do not keep side files such as `.env.local` or `.env.*.bak`. They are
#     never loaded; `make env-doctor` reports them so they can be folded in here
#     and deleted.
# ============================================================

# ─── REDCap API ─────────────────────────────────────────────
# Obtain project-scoped, export-only API tokens from REDCap. Keep every real
# value in this ignored local file or a managed secret store. Never expose a
# REDCap token to Vite, browser code, Cloudflare Pages, logs, or build artifacts.
REDCAP_ABC_SURVEYS_TOKEN=
REDCAP_IPSA_SURVEYS_TOKEN=
REDCAP_ACTION_TOKEN=
REDCAP_IPSA_LAB_TOKEN=
REDCAP_ABC_LAB_TOKEN=
REDCAP_NICO_TOKEN=
REDCAP_NANO_SURVEYS_TOKEN=
REDCAP_NANO_LAB_TOKEN=
# Legacy single-project tools and local container profiles still read this
# compatibility key. It is never used by the public Pages build or portfolio job.
REDCAP_API_TOKEN=
# USC REDCap API calls use the root /api/ endpoint, not the versioned app path.
REDCAP_API_URL=https://redcap.research.sc.edu/api/
REDCAP_VISIT_POLL_INTERVAL_S=300

# Optional browser redirect target for "Open in REDCap"; if blank, the backend
# derives it from REDCAP_API_URL without exposing the API URL to the frontend.
REDCAP_APP_URL=

# Build-time origin for the dashboard's "Open in REDCap" links. This is a VITE_
# variable because the canonical Pages deployment is a static site with no
# backend to derive it from, so it must be baked in at build time.
#
# Links go to project home only: <origin>/index.php?pid=<project_id>. That form
# is verified against this instance; the version-prefixed redcap_vNN paths 404.
# Only the project id travels in the URL -- never a record id or API token.
#
# Leave blank to hide the links entirely, which is the safe default for any
# public build. Must be https.
VITE_REDCAP_APP_ORIGIN=

# REDCap Project IDs (ask PI for values)
REDCAP_PROJECT_ID_MAIN=12345
REDCAP_PROJECT_ID_QUESTIONNAIRES=12346

# ─── Secure Data Drive ──────────────────────────────────────
# Mount point for the USC encrypted research drive
# macOS: /Volumes/nano_secure
# Linux: /mnt/nano_secure
NANO_DATA_ROOT=/Volumes/nano_secure

# ─── Sub-directories (relative to NANO_DATA_ROOT) ───────────
# These are set automatically from config/paths.yml using NANO_DATA_ROOT
# Override here only if your mount differs from standard layout
RAW_ECG_DIR=${NANO_DATA_ROOT}/raw/ecg
PROCESSED_ECG_DIR=${NANO_DATA_ROOT}/processed/ecg
RAW_TEMP_DIR=${NANO_DATA_ROOT}/raw/temperature
PROCESSED_TEMP_DIR=${NANO_DATA_ROOT}/processed/temperature
VIDEO_DIR=${NANO_DATA_ROOT}/raw/video
BEHAVIORAL_CODING_DIR=${NANO_DATA_ROOT}/processed/behavioral_coding
REDCAP_EXPORT_DIR=${NANO_DATA_ROOT}/redcap_exports
MODELS_DIR=${NANO_DATA_ROOT}/models
OUTPUTS_DIR=${NANO_DATA_ROOT}/outputs

# ─── Docker Build Knobs ─────────────────────────────────────
# Non-secret package-manager pin used by docker/dashboard/Dockerfile.
PIP_VERSION=25.3

# ─── Email Notifications ────────────────────────────────────
# Used by redcap_daily_sync.py to alert PI of issues
SMTP_HOST=smtp.sc.edu
SMTP_PORT=587
SMTP_USER=your_netid@mailbox.sc.edu
SMTP_PASSWORD=your_smtp_password
PI_EMAIL=pi@institution.edu
NOTIFY_EMAIL_LIST=pi@institution.edu,study-coordinator@institution.edu

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs/

# ─── Public Dashboard Sharing ───────────────────────────────
# The repo supports three sharing modes via `scripts/share_dashboard.sh`:
#
#   make dashboard-share        --mode auto    (default)
#   make share-named            --mode named   (require stable hostname)
#   make share-quick            --mode quick   (force random hostname)
#
# CANONICAL public URLs:
#
#   * Stable named tunnel hostname (Tier 1, preferred)
#       Requires:
#         - Cloudflare account with the DNS zone (e.g. esdlabsc.com) attached.
#         - A named tunnel created in the Cloudflare Zero Trust dashboard.
#         - A public hostname mapped to the dashboard origin.
#         - The tunnel token + the public hostname both set below.
#         - Public DNS for that hostname must be managed in the same Cloudflare
#           account as the tunnel. An external-DNS-only CNAME is not a complete
#           Cloudflare Tunnel publication path.
#       Result: --mode named prints a stable hostname such as
#         https://esd-lab-namo.sc.edu/
#       and that hostname stays the same across restarts.
#
#   * Cloudflare Pages dashboard (Tier 2, durable fallback)
#       URL: https://esd-lab-namo.pages.dev/
#       The packaged SPA proxies /api only to a healthy, operator-managed HTTPS
#       origin. Without one it serves the built-in fallback API, so a rotating
#       quick tunnel can never take the canonical site down. Build artifacts live
#       under dist/pages-wrapper; deploy them with:
#         make pages-deploy
#       or `npx --yes wrangler@3.112.0 pages deploy dist/pages-wrapper --project-name esd-lab-namo`.
#       Use fallback-only mode when the account has no stable backend hostname.
#
#   * Quick tunnel preview (Tier 3, temporary)
#       https://<random>.trycloudflare.com/dashboard/
#       The hostname rotates on every restart. It may be shared for a short live
#       demo, but is never embedded in or monitored as the canonical Pages API.
#
# Leaving both named-tunnel values blank starts a quick runtime preview while the
# canonical Pages site remains in durable fallback-only mode. Setting only one
# named-tunnel value is an error and the script exits.
CLOUDFLARE_TUNNEL_TOKEN=
# Backward-compatible alias accepted by scripts/share_dashboard.sh.
CLOUDFLARED_TUNNEL_TOKEN=
# Named tunnels require a hostname on a DNS zone you control in Cloudflare.
# Do not set this to a *.pages.dev URL.
DASHBOARD_PUBLIC_HOSTNAME=
DASHBOARD_HOST_PORT=8080
# Cross-origin browser access is denied unless explicitly listed. Same-origin
# requests remain available automatically. Keep production traffic same-origin
# through the Pages worker or named tunnel whenever possible.
DASHBOARD_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DASHBOARD_MAX_REQUEST_BODY_BYTES=1048576
# The backend accepts the Pages worker's forwarded client IP only when
# Cloudflare's platform-controlled CF-Worker header identifies this exact zone.
DASHBOARD_TRUSTED_CLOUDFLARE_WORKER_ZONE=esd-lab-namo.pages.dev
# Protect mutation endpoints with either Authorization: Bearer <token> or
# X-Operator-Token. Use a secret manager in production.
DASHBOARD_OPERATOR_TOKEN=

# Named tunnel metadata (required for --mode named):
#   CLOUDFLARE_TUNNEL_ID   — UUID of the named tunnel from Zero Trust dashboard
#   CLOUDFLARE_TUNNEL_NAME — friendly display name shown in Cloudflare dashboard
#   CLOUDFLARE_TEAM_DOMAIN — Zero Trust team domain for Access policies
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_NAME=
CLOUDFLARE_TEAM_DOMAIN=

# Cloudflare Pages deploy (for `make pages-deploy`):
#   CLOUDFLARE_API_TOKEN   — required by wrangler; minimum Pages:Edit + Account:Read.
#                              Add Account > Cloudflare Tunnel:Read/Edit if you
#                              want tunnel inspection or management through API.
#   CLOUDFLARE_ACCOUNT_ID  — wrangler auto-picks this up when API token is set
#   CLOUDFLARE_ZONE_ID     — optional; only set this if the hostname's DNS zone
#                              is actually present in this Cloudflare account
#   CLOUDFLARE_PAGES_PROJECT — Pages project name; defaults to esd-lab-namo
#   CLOUDFLARE_PAGES_BRANCH  — production branch alias; defaults to main
# DASHBOARD_STABLE_SHARE_URL — string the share script can echo as the canonical
#                              URL; defaults to https://esd-lab-namo.pages.dev/
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PAGES_PROJECT=esd-lab-namo
CLOUDFLARE_PAGES_BRANCH=main
DASHBOARD_STABLE_SHARE_URL=https://esd-lab-namo.pages.dev/
# Optional stable backend origin for Pages packaging / CI. Prefer a named
# tunnel or other durable HTTPS origin, not runtime-share.pages.dev.
PAGES_API_ORIGIN=
# When true, share_dashboard.sh may republish the canonical Pages worker for a
# healthy named origin. Ephemeral quick-tunnel origins are always rejected.
AUTO_DEPLOY_CANONICAL_PAGES=

# ─── Assistant (ESD Buddy) provider chain ───────────────────────
# Every backend speaks the OpenAI chat-completions protocol. Tiers are tried in
# order; a tier with no credential is skipped rather than left to fail on every
# request, and the first healthy tier answers. This is what keeps ESD Buddy
# responding when a single provider is rate-limited or down.
#
#   gemini  Google's OpenAI-compatible endpoint. Fastest, and the default
#           primary because it returns concise grounded answers in ~1s.
#   nvidia  NVIDIA hosted Nemotron. Strongest, slower, needs an NVIDIA key.
#   local   Docker Model Runner on this machine. No credential, no network,
#           so it still answers when both hosted tiers are unreachable.
#
# Leave DASHBOARD_ASSISTANT_FALLBACK_CHAIN blank to use the default order
# (primary provider first, then the remaining tiers). Set it to pin an order,
# e.g. "gemini,nvidia,local" or "local,gemini".
DASHBOARD_ASSISTANT_ENABLED=true
DASHBOARD_ASSISTANT_PROVIDER=gemini
DASHBOARD_ASSISTANT_FALLBACK_CHAIN=

# Google Gemini (primary). Key from Google AI Studio.
DASHBOARD_ASSISTANT_GEMINI_API_KEY=
DASHBOARD_ASSISTANT_GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# gemini-3.5-flash answers grounded dashboard questions in about a second.
# Do not use a *-flash-lite id here: it rejects reasoning_effort, which is how
# the backend suppresses a visible reasoning trace.
DASHBOARD_ASSISTANT_GEMINI_MODEL=gemini-3.5-flash

# Local Docker Model Runner (last-resort tier, never leaves the machine).
# Enable after `make model-pull`. The endpoint is Docker Desktop's published
# OpenAI-compatible port.
DASHBOARD_ASSISTANT_LOCAL_ENABLED=false
DASHBOARD_ASSISTANT_LOCAL_API_BASE=http://localhost:12434/engines/v1
DASHBOARD_ASSISTANT_LOCAL_MODEL=ai/qwen2.5:7b

# NVIDIA hosted Nemotron. Self-hosted Nemotron 3 Super 120B needs dedicated
# multi-GPU infrastructure, so the hosted API is the supported path.
DASHBOARD_ASSISTANT_RUNTIME=nvidia-build-api
DASHBOARD_ASSISTANT_API_BASE=https://integrate.api.nvidia.com/v1
DASHBOARD_ASSISTANT_API_KEY=
DASHBOARD_ASSISTANT_MODEL=nvidia/nemotron-3-super-120b-a12b
DASHBOARD_ASSISTANT_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
DASHBOARD_ASSISTANT_ENABLE_THINKING=false
DASHBOARD_ASSISTANT_REASONING_BUDGET=0
DASHBOARD_ASSISTANT_MAX_NEW_TOKENS=16384
DASHBOARD_ASSISTANT_TEMPERATURE=0.2
DASHBOARD_ASSISTANT_TOP_P=0.95
DASHBOARD_ASSISTANT_STREAM=true
DASHBOARD_ASSISTANT_REQUEST_TIMEOUT_SECONDS=180
DASHBOARD_ASSISTANT_MAX_RETRIES=6
DASHBOARD_ASSISTANT_RETRY_BASE_SECONDS=2
DASHBOARD_ASSISTANT_RETRY_MAX_SECONDS=30
DASHBOARD_ASSISTANT_RETRY_JITTER=0.25
DASHBOARD_ASSISTANT_QUEUE_TIMEOUT_SECONDS=180
DASHBOARD_ASSISTANT_CONTEXT_BUDGET=12000
DASHBOARD_ASSISTANT_MAX_CONCURRENCY=2
DASHBOARD_ASSISTANT_CIRCUIT_FAILURE_THRESHOLD=3
DASHBOARD_ASSISTANT_CIRCUIT_RECOVERY_SECONDS=60
DASHBOARD_ASSISTANT_RATE_LIMIT_REQUESTS=12
DASHBOARD_ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=60
DASHBOARD_AUDIT_RATE_LIMIT_REQUESTS=120
DASHBOARD_AUDIT_RATE_LIMIT_WINDOW_SECONDS=60
DASHBOARD_ASSISTANT_MAX_MESSAGE_CHARS=6000
DASHBOARD_ASSISTANT_MAX_HISTORY_CHARS=8000
# Local CLI use may load the repository .env. Containers set this false so the
# dashboard receives only the explicit application allowlist from Compose.
DASHBOARD_ASSISTANT_LOAD_DOTENV=true
# Optional future self-hosted NIM endpoint. Leave disabled unless you have the
# required GPU capacity and an OpenAI-compatible NVIDIA NIM deployment.
DASHBOARD_ASSISTANT_SELF_HOSTED_ENABLED=false
DASHBOARD_ASSISTANT_SELF_HOSTED_BASE_URL=http://nemotron-nim:8000/v1
# OpenAI-compatible client aliases for the NVIDIA endpoint.
OPENAI_BASE_URL=${DASHBOARD_ASSISTANT_API_BASE}
OPENAI_API_KEY=${DASHBOARD_ASSISTANT_API_KEY}

# Presentation Maker planner (async deck generation). JSON mode constrains the
# provider toward valid JSON, improving valid-plan rate and latency. The server
# still falls back to extract-and-repair when a response is not valid JSON.
DASHBOARD_PRESENTATION_JSON_MODE=true
DASHBOARD_PRESENTATION_MAX_TOKENS=768
DASHBOARD_PRESENTATION_CONTEXT_CAP=1200
DASHBOARD_PRESENTATION_MAX_CONCEPT_CHARS=6000
DASHBOARD_PRESENTATION_JOB_DB=dashboard/data/presentation_jobs.sqlite3
DASHBOARD_PRESENTATION_JOB_TTL_SECONDS=900
DASHBOARD_PRESENTATION_JOB_MAX=64
DASHBOARD_PRESENTATION_JOB_LOCK_TIMEOUT=180
DASHBOARD_PRESENTATION_JOB_STALE_SECONDS=15
DASHBOARD_PRESENTATION_JOB_HEARTBEAT_SECONDS=3
DASHBOARD_PRESENTATION_POLL_QUEUED_MS=900
DASHBOARD_PRESENTATION_POLL_RUNNING_MS=1400
DASHBOARD_PRESENTATION_POLL_SLOW_MS=2400
DASHBOARD_PRESENTATION_POLL_SLOW_AFTER_SECONDS=18

# ─── Kubernetes Readings Pipeline + Cluster Observability ────────────────
# Local mode remains the default. Set K8S_MODE_ENABLED=true only inside the
# Kubernetes deployment where the readings/data volumes are mounted.
K8S_MODE_ENABLED=false
K8S_NAMESPACE=default
PIPELINE_ENVIRONMENT=local
READINGS_WATCH_PATH=esd-lab-readings
DASHBOARD_DATA_DIR=dashboard/data
READINGS_DATA_OUTPUT=dashboard/data/readings_data.json
LAB_READINGS_OUTPUT=web/lab-readings.json
READINGS_PIPELINE_STATUS_PATH=dashboard/data/readings_pipeline_status.json
READINGS_PIPELINE_LEDGER_PATH=dashboard/data/readings_pipeline_events.jsonl
READINGS_EVENT_STATE_PATH=dashboard/data/readings_event_state.json
READINGS_PIPELINE_LEASE_PATH=dashboard/data/readings_pipeline.lock
WEB_PACKAGE_TRIGGER_PATH=dashboard/data/web_package_trigger.json
READINGS_EVENT_DEBOUNCE_SECONDS=5
READINGS_WATCHER_POLL_SECONDS=2
PIPELINE_MAX_RETRIES=3
PIPELINE_RETRY_BASE_SECONDS=1
PIPELINE_RETRY_MAX_SECONDS=30
PIPELINE_LEASE_TTL_SECONDS=900
K8S_API_TIMEOUT_SECONDS=2.5
CLUSTER_VISUALIZATION_ENABLED=true
ASSISTANT_CLUSTER_CONTEXT_ENABLED=true
K8S_WORKER_IMAGE=
K8S_WORKER_SERVICE_ACCOUNT=esd-lab-dashboard
K8S_READINGS_PVC=
K8S_DATA_PVC=
# Helm/Kubernetes deployment controls used by Makefile targets.
K8S_HELM_NAMESPACE=esd-lab
K8S_HELM_RELEASE=esd-lab-dashboard
K8S_HELM_CHART=k8s/helm/esd-lab-dashboard
K8S_SECRET_NAME=esd-lab-dashboard-secrets
# Existing RWX claims that must already exist in your cluster.
K8S_READINGS_CLAIM=esd-readings-rwx
K8S_DATA_CLAIM=esd-dashboard-data-rwx
# Runtime image coordinates for Helm release updates.
K8S_IMAGE_REPOSITORY=esd-lab-dashboard
K8S_IMAGE_TAG=local
# Optional secret-backed hook for Pages redeploy metadata. Never commit a real
# deploy URL; in Kubernetes this is normally injected from a Secret.
PAGES_DEPLOY_HOOK_URL=

# ─── Pipeline Settings ──────────────────────────────────────
N_JOBS=-1  # -1 = use all available CPU cores
RANDOM_SEED=42

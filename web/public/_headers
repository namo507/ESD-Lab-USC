/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://server.arcgisonline.com; connect-src 'self' https://*.trycloudflare.com http://127.0.0.1:8080 http://localhost:8080 http://127.0.0.1:1234 http://localhost:1234; frame-src 'self' https://*.trycloudflare.com; frame-ancestors 'self'; form-action 'self'

/api/*
  Cache-Control: no-store

# Aggregate REDCap status must be revalidated on every request; the retired
# dashboard_data.json artifact is no longer published by the Pages packager.
/dashboard/data/dashboard_metrics.json
  Cache-Control: no-store, must-revalidate
  X-Content-Type-Options: nosniff

# Aggregate-only REDCap portfolio structure and its lazily fetched field index.
/dashboard/data/redcap_portfolio.json
  Cache-Control: no-store, must-revalidate
  X-Content-Type-Options: nosniff

/dashboard/data/redcap_portfolio_fields.json
  Cache-Control: no-store, must-revalidate
  X-Content-Type-Options: nosniff

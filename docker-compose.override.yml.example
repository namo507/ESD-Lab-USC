# Copy this file to docker-compose.override.yml for workstation-specific
# settings. The real override file is intentionally ignored by git.

services:
  dashboard:
    ports:
      - "${DASHBOARD_HOST_PORT:-18080}:8080"
    environment:
      # Put the real key in the untracked .env file, never in this override.
      DASHBOARD_ASSISTANT_API_KEY: ${DASHBOARD_ASSISTANT_API_KEY:-}
      DASHBOARD_ASSISTANT_PROVIDER: nvidia
      DASHBOARD_ASSISTANT_RUNTIME: nvidia-build-api
    mem_limit: 2g

  dashboard-share:
    profiles: ["share"]

  dashboard-share-named:
    profiles: ["share"]
